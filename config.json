{
    "hosts": {
        "vmix": {
            "host": "127.0.0.1",
            "apiPort": 8099,
            "webPort": 8088
        },
        "bose": {
            "host": "192.168.127.6",
            "port": 10055
        },
        "mediaout": {
            "host": "127.0.0.1",
            "portTx": 5400,
            "portRx": 6400
        }
    },
    "midi": {
        "input": "MIDI Mix",
        "output": "MIDI Mix"
    },
    "sliders":{
        "1": {
            "name": "Master",
            "midiCC": 62,
            "vmix": {
                "input": "M",
                "function": "Volume"
            }
        },
        "2": {
            "name": "Slider_1",
            "midiCC": 19,
            "vmix": {
                "input": "1",
                "function": "Volume"
            },
            "bose": {
                "channel": 1,
                "function": "Gain"
            }
        },
        "3": {
            "name": "Slider_2",
            "midiCC": 23,
            "bose": {
                "channel": 2,
                "function": "Gain"
            }
        }
    },
    "buttons":{
        "1": {
            "name": "Button_1",
            "midiNote": 1,
            "ledFeedBack": "vmix",
            "vmix": {
                "input": "M",
                "function": "TOGGLE_MUTE_CHANNEL"
            },
            "bose": {
                "channel": 1,
                "function": "TOGGLE_MUTE_CHANNEL"
            }
        },
        "2": {
            "name": "Button_2",
            "midiNote": 4,
            "ledFeedBack": "vmix",
            "vmix": {
                "input": "A",
                "function": "TOGGLE_MUTE_CHANNEL"
            },
            "bose": {
                "channel": 2,
                "function": "TOGGLE_MUTE_CHANNEL"
            }
        },
        "3": {
            "name": "Button_3",
            "midiNote": 7,
            "ledFeedBack": "vmix",
            "vmix": {
                "input": "1",
                "function": "TOGGLE_MUTE_CHANNEL"
            },
            "bose": {
                "channel": 3,
                "function": "TOGGLE_MUTE_CHANNEL"
            },
            "mediaout": {
                "function": "CUE"
            }
        },
        "4": {
            "name": "Button_4",
            "midiNote": 10,
            "ledFeedBack": "vmix",
            "vmix": {
                "input": "G",
                "function": "TOGGLE_MUTE_CHANNEL"
            },
            "bose": {
                "channel": 4,
                "function": "TOGGLE_MUTE_CHANNEL"
            }
        }
    }
